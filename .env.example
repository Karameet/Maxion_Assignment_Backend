# Copy to .env and adjust. Placeholders only — never commit real secrets.
PORT=8080
APP_ENV=dev
DATABASE_URL=postgres://orders:orders@localhost:5433/orders?sslmode=disable
TEST_DATABASE_URL=postgres://orders:orders@localhost:5433/orders_test?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
JWT_ISSUER=order-api
JWT_TTL=168h
BCRYPT_COST=12
MAX_BODY_BYTES=16384
MAX_ORDER_QUANTITY=99
# postgres | memory (memory = no DB needed, data lost on restart)
ORDER_REPO=postgres
# dev only; Load() refuses to start with APP_ENV=prod and this set to true
ENABLE_FAULT_INJECTION=false
ORDERS_REQUIRE_EMAIL_ACCOUNT=false
# requests per minute per IP on /api/auth/login + /api/auth/register (0 = off)
AUTH_RATE_LIMIT_PER_MIN=10
CORS_ALLOWED_ORIGINS=*
